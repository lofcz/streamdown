{
  "name": "streamdown-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "pnpm build --filter @lofcz/streamdown --filter @lofcz/streamdown-math --filter @lofcz/streamdown-code --filter @lofcz/streamdown-cjk --filter @lofcz/streamdown-mermaid --filter @lofcz/remend",
    "dev": "turbo run dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && pnpm release:publish",
    "release:publish": "node scripts/skip-published-packages.mjs && changeset publish",
    "bench": "turbo run bench",
    "bench:ui": "turbo run bench:ui",
    "bump-deps": "npx npm-check-updates -u --deep -x \"recharts\" && pnpm i"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "ultracite": "7.2.4"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": ">=4.17.23",
      "remark-gfm": "npm:@lofcz/remark-gfm@^4.0.1"
    }
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18"
  }
}
